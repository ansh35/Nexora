# Database Connection (MongoDB Replica Set / Atlas)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster.mongodb.net/nexora?retryWrites=true&w=majority"

# Authentication (NextAuth.js v5)
AUTH_SECRET="your-auth-secret-at-least-32-chars-here"
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Application Public URL (used for email verification & invite links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cron / Keepalive & Internal Health Ping Secret Header (x-keepalive-key)
KEEPALIVE_SECRET="your-secret-ping-key-here"

# Resend Email Service Configuration
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="Nexora <onboarding@yourdomain.com>"

# Pusher Real-time Channels Configuration
PUSHER_APP_ID="your_pusher_app_id"
NEXT_PUBLIC_PUSHER_APP_KEY="your_pusher_app_key"
PUSHER_SECRET="your_pusher_secret"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"

# AI Model Provider (Groq API)
GROQ_API_KEY="gsk_your_groq_api_key_here"
